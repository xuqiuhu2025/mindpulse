# ===== MindPulse 开发环境示例配置 =====
# 复制为 .env 并按需修改。.env 永远不要提交到仓库（已在 .gitignore）。
# 严禁把真实 API key 提交到 GitHub 或写入 iOS 客户端。

# 应用环境：development | production
MINDPULSE_ENVIRONMENT=development

# 日志级别（日志中绝不输出聊天原文、健康数值、API key 或用户身份）
MINDPULSE_LOG_LEVEL=INFO

# 数据库（默认本地 SQLite；docker-compose 中挂载到卷）
MINDPULSE_DATABASE_URL=sqlite:///./mindpulse.db

# ---- LLM Provider ----
# offline：默认值，零依赖可运行（开发/测试）
# openai_compatible：任何兼容 OpenAI Chat Completions 的供应商
#   （OpenAI / DeepSeek / Moonshot / GLM / vLLM / Ollama 等），改 BASE_URL 即可
MINDPULSE_LLM_PROVIDER=offline
MINDPULSE_LLM_API_KEY=
MINDPULSE_LLM_BASE_URL=https://api.openai.com/v1
MINDPULSE_LLM_MODEL=gpt-4o-mini
MINDPULSE_LLM_TIMEOUT_SECONDS=30

# ---- CORS（本地 Web 调试用；iOS 原生客户端不受 CORS 限制）----
MINDPULSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
